{
  "name": "migrainelog",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/fix-expo-cli-widget.js",
    "start": "expo start",
    "android": "expo run:android",
    "prewidget": "EXPO_NO_GIT_STATUS=1 npx expo prebuild -p ios --clean",
    "prewidget:blank": "EXPO_NO_GIT_STATUS=1 npx expo prebuild --template ./node_modules/@bacons/apple-targets/prebuild-blank.tgz --clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.3",
    "@expo/prebuild-config": "^54.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "modules"
    }
  },
  "private": true
}
